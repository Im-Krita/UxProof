{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uxproof.local/schemas/scenario-events-v0.1.schema.json",
  "title": "UXProof scenario events v0.1",
  "type": "object",
  "required": ["runId", "scenarioEventsVersion", "scenarioEvents"],
  "properties": {
    "runId": { "type": "string", "pattern": "\\S" },
    "scenarioEventsVersion": { "const": "0.1" },
    "scenarioEvents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["eventId", "runId", "combinationId", "scenarioId", "viewportId", "stepId", "stepType", "phase", "at"],
        "properties": {
          "eventId": { "type": "string", "pattern": "\\S" }, "runId": { "type": "string", "pattern": "\\S" },
          "combinationId": { "type": "string", "pattern": "\\S" }, "scenarioId": { "type": "string", "pattern": "\\S" },
          "viewportId": { "type": "string", "pattern": "\\S" }, "stepId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
          "stepType": { "type": "string", "pattern": "\\S" }, "phase": { "enum": ["before", "action", "after", "error"] },
          "pageScope": { "type": "string", "pattern": "^https?://[^?#]+$" },
          "at": { "type": "string", "format": "date-time" },
          "screenshot": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,160}\\.png$" }] },
          "domSummary": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/domSummary" }] },
          "elementGeometry": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/elementGeometry" }] }
        },
        "allOf": [{ "if": { "properties": { "phase": { "const": "error" } }, "required": ["phase"] },
          "then": { "required": ["screenshot"], "allOf": [{ "if": { "properties": { "elementGeometry": { "type": "object" } }, "required": ["elementGeometry"] }, "then": { "properties": { "screenshot": { "type": "string" } } } }] }, "else": { "not": { "anyOf": [{ "required": ["screenshot"] }, { "required": ["domSummary"] }, { "required": ["elementGeometry"] }] } } },
          { "if": { "properties": { "phase": { "enum": ["before", "action"] } }, "required": ["phase"] }, "then": { "not": { "required": ["pageScope"] } } }]
      }
    }
  },
  "$defs": {
    "elementGeometry": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y", "width", "height", "viewportWidth", "viewportHeight", "deviceScaleFactor", "scrollX", "scrollY"],
      "properties": {
        "x": { "type": "number", "minimum": -10000000, "maximum": 10000000 }, "y": { "type": "number", "minimum": -10000000, "maximum": 10000000 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000000 }, "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000000 },
        "viewportWidth": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000000 }, "viewportHeight": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000000 },
        "deviceScaleFactor": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
        "scrollX": { "type": "number", "minimum": -10000000, "maximum": 10000000 }, "scrollY": { "type": "number", "minimum": -10000000, "maximum": 10000000 }
      }
    },
    "count": { "type": "integer", "minimum": 0, "maximum": 5000 },
    "domSummary": {
      "type": "object", "additionalProperties": false, "required": ["capturedAt", "viewport", "visible", "coverage"],
      "properties": {
        "capturedAt": { "type": "string", "format": "date-time" },
        "viewport": { "type": "object", "additionalProperties": false, "required": ["width", "height", "deviceScaleFactor", "scrollX", "scrollY"],
          "properties": { "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 },
            "deviceScaleFactor": { "type": "number", "exclusiveMinimum": 0 }, "scrollX": { "type": "number" }, "scrollY": { "type": "number" } } },
        "visible": { "type": "object", "additionalProperties": false, "required": ["elements", "interactive", "headings", "dialogs", "forms"],
          "properties": { "elements": { "$ref": "#/$defs/count" }, "interactive": { "$ref": "#/$defs/count" }, "headings": { "$ref": "#/$defs/count" },
            "dialogs": { "$ref": "#/$defs/count" }, "forms": { "$ref": "#/$defs/count" } } },
        "coverage": { "type": "object", "additionalProperties": false, "required": ["status", "truncated", "elementsSeen", "iframes", "canvases", "openShadowRoots"],
          "properties": { "status": { "const": "partial" }, "truncated": { "type": "boolean" }, "elementsSeen": { "$ref": "#/$defs/count" },
            "iframes": { "$ref": "#/$defs/count" }, "canvases": { "$ref": "#/$defs/count" }, "openShadowRoots": { "$ref": "#/$defs/count" } } }
      }
    }
  }
}
