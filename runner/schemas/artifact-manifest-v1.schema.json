{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uxproof.local/schemas/artifact-manifest-v1.schema.json",
  "title": "UXProof artifact manifest v1",
  "type": "object",
  "required": ["schemaVersion", "runId", "artifacts"],
  "properties": {
    "schemaVersion": { "const": "1.0" }, "runId": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object", "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string", "pattern": "^(report\\.json|report\\.html|screenshots/[a-zA-Z0-9_-]{1,160}\\.png|traces/trace-[1-9][0-9]*-[1-9][0-9]*\\.zip)$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
