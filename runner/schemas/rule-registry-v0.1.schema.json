{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uxproof.local/schemas/rule-registry-v0.1.schema.json",
  "type": "object", "additionalProperties": false, "required": ["schemaVersion", "rules"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["ruleId", "version", "title", "category", "scope", "requiredEvidence", "trigger", "exclusions", "classification", "remediation", "fixtures", "status"],
      "properties": {
        "ruleId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "title": { "type": "string", "minLength": 1 }, "category": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "requiredEvidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "trigger": { "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["type", "toleranceCssPx"],
            "properties": { "type": { "const": "viewport-overflow" }, "toleranceCssPx": { "type": "number", "minimum": 0, "maximum": 20 } } },
          { "type": "object", "additionalProperties": false, "required": ["type", "minOccurrences"],
            "properties": { "type": { "const": "duplicate-headings" }, "minOccurrences": { "const": 2 } } }
        ] },
        "exclusions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "classification": { "enum": ["technical-fact", "semantic-hypothesis"] }, "remediation": { "type": "string", "minLength": 1 },
        "fixtures": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "status": { "enum": ["enabled", "disabled"] }
      },
      "allOf": [
        { "if": { "properties": { "trigger": { "properties": { "type": { "const": "viewport-overflow" } } } } }, "then": { "properties": { "classification": { "const": "technical-fact" } } } },
        { "if": { "properties": { "trigger": { "properties": { "type": { "const": "duplicate-headings" } } } } }, "then": { "properties": { "classification": { "const": "semantic-hypothesis" } } } }
      ]
    }
  }
}
