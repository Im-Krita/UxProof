{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "isolatedModules": true, "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@uxproof/audit-config-limits.json": ["./runner/schemas/audit-config-limits.json"],
      "@uxproof/rule-registry.json": ["./runner/rules/registry-v0.1.json"]
    },
    "allowImportingTsExtensions": true, "noEmit": true, "types": ["vite/client"]
  },
  "include": ["src", "shared", "runner/schemas/audit-config-limits.json", "runner/rules/registry-v0.1.json"]
}
