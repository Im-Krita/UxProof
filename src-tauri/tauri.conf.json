{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UXProof",
  "version": "0.1.0",
  "identifier": "dev.uxproof.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "UXProof", "width": 1360, "height": 850, "minWidth": 940, "minHeight": 650, "backgroundColor": "#f7f8fa" }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "resources": {
      "../runner/ai.mjs": "runner/ai.mjs",
      "../runner/artifacts.mjs": "runner/artifacts.mjs",
      "../runner/audit.mjs": "runner/audit.mjs",
      "../runner/cli.mjs": "runner/cli.mjs",
      "../runner/comparison.mjs": "runner/comparison.mjs",
      "../runner/events.mjs": "runner/events.mjs",
      "../runner/findings.mjs": "runner/findings.mjs",
      "../runner/guard-proxy.mjs": "runner/guard-proxy.mjs",
      "../runner/html.mjs": "runner/html.mjs",
      "../runner/policy.mjs": "runner/policy.mjs",
      "../runner/report-contract.mjs": "runner/report-contract.mjs",
      "../runner/screenshot.mjs": "runner/screenshot.mjs",
      "../runner/validators.mjs": "runner/validators.mjs",
      "../runner/package.json": "runner/package.json",
      "../runner/package-lock.json": "runner/package-lock.json",
      "../runner/schemas/*.json": "runner/schemas/",
      "../runner/node_modules/@axe-core/playwright/": "runner/node_modules/@axe-core/playwright/",
      "../runner/node_modules/axe-core/": "runner/node_modules/axe-core/",
      "../runner/node_modules/playwright/": "runner/node_modules/playwright/",
      "../runner/node_modules/playwright-core/": "runner/node_modules/playwright-core/"
    }
  }
}
